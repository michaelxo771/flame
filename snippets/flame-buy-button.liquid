{%- comment -%}
  Lumisca — shared buy button. Resolves the store's flame diffuser product
  automatically (one-product store) and links to it. No customizer setup needed.
  Params: label (string), class (extra css classes, optional)
{%- endcomment -%}
{%- liquid
  assign fp = collections.all.products.first
  for p in collections.all.products
    if p.title contains 'Diffuser' or p.title contains 'Flame' or p.title contains 'Lumisca'
      assign fp = p
      break
    endif
  endfor
  assign href = fp.url | default: '/products'
-%}
<a href="{{ href }}" class="button{% if class %} {{ class }}{% endif %}">{{ label | default: 'Shop Now' | escape }}</a>
