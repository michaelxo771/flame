{%- comment -%}
  Lumisca — shared premium CTA. Resolves the store's diffuser automatically.
  Params: label (string), class (extra classes), style ('ghost' for outline)
{%- endcomment -%}
{%- liquid
  assign fp = collections.all.products.first
  for p in collections.all.products
    if p.title contains 'Diffuser' or p.title contains 'Flame' or p.title contains 'Lumisca'
      assign fp = p
      break
    endif
  endfor
  assign href = fp.url | default: '/collections/all'
-%}
<a href="{{ href }}" class="flame-btn{% if style == 'ghost' %} flame-btn--ghost{% endif %}{% if class %} {{ class }}{% endif %}">{{ label | default: 'Shop Now' | escape }}</a>
