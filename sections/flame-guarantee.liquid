{%- comment -%} Lumisca — Guarantee (dark centerpiece, gold seal) {%- endcomment -%}
{%- style -%}
  #shopify-section-{{ section.id }} .flame-gr { background: var(--bg-deep); position: relative; overflow: hidden; }
  #shopify-section-{{ section.id }} .flame-gr__glow { position: absolute; z-index: 0; left: 50%; top: 50%; transform: translate(-50%,-50%); width: 80vw; max-width: 760px; aspect-ratio: 1; background: var(--ember-glow); filter: blur(30px); opacity: .55; }
  #shopify-section-{{ section.id }} .flame-gr__inner { position: relative; z-index: 1; max-width: 640px; margin: 0 auto; text-align: center; }
  #shopify-section-{{ section.id }} .flame-gr__seal { width: 84px; height: 84px; margin: 0 auto 2.4rem; color: var(--gold); }
  #shopify-section-{{ section.id }} .flame-gr__seal svg { width: 100%; height: 100%; }
  #shopify-section-{{ section.id }} .flame-gr__title { font-size: clamp(3rem, 5vw, 4.2rem); color: var(--text-cream); line-height: 1.06; margin: 0 0 1.8rem; text-wrap: balance; }
  #shopify-section-{{ section.id }} .flame-gr__body { font-size: 1.7rem; line-height: 1.7; color: var(--text-muted); margin: 0 0 3rem; }
  @media screen and (min-width: 750px) { #shopify-section-{{ section.id }} .flame-gr__body { padding-inline: 2rem; } }
{%- endstyle -%}

<div class="flame-gr flame-section flame-grain">
  <div class="flame-gr__glow" aria-hidden="true"></div>
  <div class="flame-wrap flame-pad">
    <div class="flame-gr__inner flame-reveal">
      <div class="flame-gr__seal" aria-hidden="true">
        <svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="1.4">
          <circle cx="50" cy="50" r="34"/><circle cx="50" cy="50" r="40" stroke-dasharray="2 4"/>
          <path d="M38 50l8 8 16-18" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
      <p class="flame-kicker flame-kicker--center">Risk-Free</p>
      <h2 class="flame-gr__title">Try Lumisca Risk-Free for 30 Days</h2>
      <p class="flame-gr__body">If your Lumisca doesn't turn your space into the cosy escape you hoped for, send it back within 30 days for a full refund — no fuss, no awkward questions. That's how confident we are you'll love it.</p>
      {% render 'flame-buy-button', label: 'Get Mine Now' %}
    </div>
  </div>
</div>

{% schema %}
{ "name": "Flame Guarantee", "tag": "section", "class": "flame-section", "settings": [], "presets": [ { "name": "Flame Guarantee" } ] }
{% endschema %}
