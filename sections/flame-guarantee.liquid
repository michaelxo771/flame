{%- comment -%} Lumisca — Guarantee / Risk Reversal {%- endcomment -%}
{%- style -%}
  #shopify-section-{{ section.id }} .flame-guar { padding: 5rem 0; text-align: center; }
  #shopify-section-{{ section.id }} .flame-guar__inner { max-width: 640px; margin: 0 auto; }
  #shopify-section-{{ section.id }} .flame-guar__badge { font-size: 3.4rem; line-height: 1; margin-bottom: 1.4rem; }
  #shopify-section-{{ section.id }} .flame-guar__title { font-size: 2.8rem; line-height: 1.15; margin: 0 0 1.4rem; text-wrap: balance; }
  #shopify-section-{{ section.id }} .flame-guar__body { font-size: 1.65rem; line-height: 1.6; opacity: .92; margin: 0 0 2.2rem; }
  #shopify-section-{{ section.id }} .flame-guar__cta { min-width: 220px; font-size: 1.65rem; padding: 1.3rem 2.4rem; }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .flame-guar { padding: 7rem 0; }
    #shopify-section-{{ section.id }} .flame-guar__title { font-size: 3.8rem; }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width flame-guar">
    <div class="flame-guar__inner">
      {%- if section.settings.badge != blank -%}<div class="flame-guar__badge" aria-hidden="true">{{ section.settings.badge }}</div>{%- endif -%}
      {%- if section.settings.title != blank -%}<h2 class="flame-guar__title">{{ section.settings.title | escape }}</h2>{%- endif -%}
      <div class="flame-guar__body rte">{{ section.settings.body }}</div>
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: '#' }}" class="button flame-guar__cta">{{ section.settings.button_label | escape }}</a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Flame Guarantee",
  "tag": "section",
  "class": "flame-section",
  "settings": [
    { "type": "text", "id": "badge", "label": "Badge (emoji)", "default": "🛡️" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Try Lumisca Risk-Free for 30 Days" },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>If your Lumisca doesn't turn your space into the cosy escape you hoped for, send it back within 30 days for a full refund — no fuss, no awkward questions. That's how confident we are you'll love it.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Get Mine Now" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" }
  ],
  "presets": [ { "name": "Flame Guarantee" } ]
}
{% endschema %}
