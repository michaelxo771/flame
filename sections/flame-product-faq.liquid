{%- comment -%}
  Lumisca — Product FAQ. Button accordion (aria-expanded, keyboard operable),
  same visual pattern as flame-product-info. Every Q/A editable via blocks.
  Emits FAQPage JSON-LD from the blocks.
{%- endcomment -%}
{%- style -%}
  #shopify-section-{{ section.id }} .flame-pf { background: var(--bg-dark); }
  #shopify-section-{{ section.id }} .flame-pf__head { text-align: center; margin-bottom: 4rem; }
  #shopify-section-{{ section.id }} .flame-pf__title { font-size: clamp(2.8rem, 4.4vw, 3.8rem); color: var(--text-cream); margin: 0; }
  #shopify-section-{{ section.id }} .flame-pf__list { max-width: 760px; margin: 0 auto; }
  #shopify-section-{{ section.id }} .flame-pf__item { border-top: 1px solid rgba(201,162,75,.22); }
  #shopify-section-{{ section.id }} .flame-pf__item:last-child { border-bottom: 1px solid rgba(201,162,75,.22); }
  #shopify-section-{{ section.id }} .flame-pf__hd { margin: 0; }
  #shopify-section-{{ section.id }} .flame-pf__btn { width: 100%; background: none; border: 0; cursor: pointer; color: var(--text-cream); font-family: var(--flame-serif); font-weight: 500; font-size: clamp(1.8rem, 2.4vw, 2.1rem); text-align: left; display: flex; align-items: center; justify-content: space-between; gap: 1.6rem; padding: 2.4rem .4rem; }
  #shopify-section-{{ section.id }} .flame-pf__btn:focus-visible { outline: 2px solid var(--gold); outline-offset: 3px; }
  #shopify-section-{{ section.id }} .flame-pf__chev { flex: 0 0 auto; width: 20px; height: 20px; color: var(--ember); transition: transform .35s var(--ease); }
  #shopify-section-{{ section.id }} .flame-pf__chev svg { width: 100%; height: 100%; display: block; }
  #shopify-section-{{ section.id }} .flame-pf__item.is-open .flame-pf__chev { transform: rotate(180deg); }
  #shopify-section-{{ section.id }} .flame-pf__panel { display: grid; grid-template-rows: 0fr; transition: grid-template-rows .4s var(--ease); }
  #shopify-section-{{ section.id }} .flame-pf__item.is-open .flame-pf__panel { grid-template-rows: 1fr; }
  #shopify-section-{{ section.id }} .flame-pf__inner { overflow: hidden; }
  #shopify-section-{{ section.id }} .flame-pf__body { color: var(--text-muted); font-size: 1.55rem; line-height: 1.7; padding: 0 .4rem 2.4rem; }
  #shopify-section-{{ section.id }} .flame-pf__body p { margin: 0; }
  #shopify-section-{{ section.id }} .flame-pf__body a { color: var(--ember); }
{%- endstyle -%}

<div class="flame-pf flame-section flame-grain">
  <div class="flame-wrap flame-pad">
    {%- if section.settings.heading != blank -%}
      <div class="flame-pf__head flame-reveal">
        <p class="flame-kicker flame-kicker--center">Good to Know</p>
        <h2 class="flame-pf__title">{{ section.settings.heading | escape }}</h2>
      </div>
    {%- endif -%}
    <div class="flame-pf__list flame-reveal" data-delay="1">
      {%- for block in section.blocks -%}
        {%- assign bid = 'pf-' | append: section.id | append: '-' | append: block.id -%}
        <div class="flame-pf__item" {{ block.shopify_attributes }}>
          <h3 class="flame-pf__hd">
            <button type="button" id="{{ bid }}-b" class="flame-pf__btn" aria-expanded="false" aria-controls="{{ bid }}-p">
              <span>{{ block.settings.question | escape }}</span>
              <span class="flame-pf__chev" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg></span>
            </button>
          </h3>
          <div class="flame-pf__panel" id="{{ bid }}-p" role="region" aria-labelledby="{{ bid }}-b">
            <div class="flame-pf__inner"><div class="flame-pf__body rte">{{ block.settings.answer }}</div></div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{%- if section.blocks.size > 0 -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for block in section.blocks -%}
    {
      "@type": "Question",
      "name": {{ block.settings.question | json }},
      "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | strip_newlines | json }} }
    }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}

<script>
  (function () {
    var s = document.getElementById('shopify-section-{{ section.id }}');
    if (!s) return;
    s.querySelectorAll('.flame-pf__btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var item = btn.closest('.flame-pf__item');
        var open = item.classList.toggle('is-open');
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Flame Product FAQ",
  "tag": "section",
  "class": "flame-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently Asked Questions", "info": "Leave blank to hide." }
  ],
  "blocks": [
    {
      "type": "qa",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Answer</p>" }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [ { "name": "Flame Product FAQ" } ]
}
{% endschema %}
