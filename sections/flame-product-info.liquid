{%- comment -%}
  Lumisca — Product information accordion. Button-based (aria-expanded, keyboard
  operable), reuses the FAQ section's type scale / spacing / gold hairline
  borders. Blocks are add/remove/reorderable in the customiser.
{%- endcomment -%}
{%- style -%}
  #shopify-section-{{ section.id }} .flame-pi { background: var(--bg-deep); }
  #shopify-section-{{ section.id }} .flame-pi__head { text-align: center; margin-bottom: 4rem; }
  #shopify-section-{{ section.id }} .flame-pi__title { font-size: clamp(2.8rem, 4.4vw, 3.8rem); color: var(--text-cream); margin: 0; }
  #shopify-section-{{ section.id }} .flame-pi__list { max-width: 760px; margin: 0 auto; }
  #shopify-section-{{ section.id }} .flame-pi__item { border-top: 1px solid rgba(201,162,75,.22); }
  #shopify-section-{{ section.id }} .flame-pi__item:last-child { border-bottom: 1px solid rgba(201,162,75,.22); }
  #shopify-section-{{ section.id }} .flame-pi__hd { margin: 0; }
  #shopify-section-{{ section.id }} .flame-pi__btn { width: 100%; background: none; border: 0; cursor: pointer; color: var(--text-cream); font-family: var(--flame-serif); font-weight: 500; font-size: clamp(1.8rem, 2.4vw, 2.1rem); text-align: left; display: flex; align-items: center; justify-content: space-between; gap: 1.6rem; padding: 2.4rem .4rem; }
  #shopify-section-{{ section.id }} .flame-pi__btn:focus-visible { outline: 2px solid var(--gold); outline-offset: 3px; }
  #shopify-section-{{ section.id }} .flame-pi__chev { flex: 0 0 auto; width: 20px; height: 20px; color: var(--ember); transition: transform .35s var(--ease); }
  #shopify-section-{{ section.id }} .flame-pi__chev svg { width: 100%; height: 100%; display: block; }
  #shopify-section-{{ section.id }} .flame-pi__item.is-open .flame-pi__chev { transform: rotate(180deg); }
  #shopify-section-{{ section.id }} .flame-pi__panel { display: grid; grid-template-rows: 0fr; transition: grid-template-rows .4s var(--ease); }
  #shopify-section-{{ section.id }} .flame-pi__item.is-open .flame-pi__panel { grid-template-rows: 1fr; }
  #shopify-section-{{ section.id }} .flame-pi__inner { overflow: hidden; }
  #shopify-section-{{ section.id }} .flame-pi__body { color: var(--text-muted); font-size: 1.55rem; line-height: 1.7; padding: 0 .4rem 2.4rem; }
  #shopify-section-{{ section.id }} .flame-pi__body p { margin: 0; }
  #shopify-section-{{ section.id }} .flame-pi__body ul, #shopify-section-{{ section.id }} .flame-pi__body ol { margin: 0; padding-left: 2rem; }
  #shopify-section-{{ section.id }} .flame-pi__body li { margin: 0 0 .6rem; }
  #shopify-section-{{ section.id }} .flame-pi__body li:last-child { margin-bottom: 0; }
  #shopify-section-{{ section.id }} .flame-pi__body a { color: var(--ember); }
{%- endstyle -%}

<div class="flame-pi flame-section flame-grain">
  <div class="flame-wrap flame-pad">
    {%- if section.settings.heading != blank -%}
      <div class="flame-pi__head flame-reveal">
        <p class="flame-kicker flame-kicker--center">The Details</p>
        <h2 class="flame-pi__title">{{ section.settings.heading | escape }}</h2>
      </div>
    {%- endif -%}
    <div class="flame-pi__list flame-reveal" data-delay="1">
      {%- for block in section.blocks -%}
        {%- assign btn_id = 'pi-btn-' | append: section.id | append: '-' | append: block.id -%}
        {%- assign panel_id = 'pi-panel-' | append: section.id | append: '-' | append: block.id -%}
        <div class="flame-pi__item" {{ block.shopify_attributes }}>
          <h3 class="flame-pi__hd">
            <button type="button" id="{{ btn_id }}" class="flame-pi__btn" aria-expanded="false" aria-controls="{{ panel_id }}">
              <span>{{ block.settings.heading | escape }}</span>
              <span class="flame-pi__chev" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg></span>
            </button>
          </h3>
          <div class="flame-pi__panel" id="{{ panel_id }}" role="region" aria-labelledby="{{ btn_id }}">
            <div class="flame-pi__inner"><div class="flame-pi__body rte">{{ block.settings.body }}</div></div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

<script>
  (function () {
    var s = document.getElementById('shopify-section-{{ section.id }}');
    if (!s) return;
    s.querySelectorAll('.flame-pi__btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var item = btn.closest('.flame-pi__item');
        var open = item.classList.toggle('is-open');
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Flame Product Info",
  "tag": "section",
  "class": "flame-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Section heading", "default": "Product Information", "info": "Leave blank to hide the heading." }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Info block",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Heading" },
        { "type": "richtext", "id": "body", "label": "Body", "default": "<p>Add details here.</p>" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Flame Product Info",
      "blocks": [
        { "type": "item", "settings": { "heading": "How to use the light", "body": "<ul><li>Press the power button once to turn the flame on</li><li>Press again to cycle through flame colours</li><li>Hold for 3 seconds to switch between continuous and intermittent mist</li></ul>" } },
        { "type": "item", "settings": { "heading": "Essential oils", "body": "<p>Compatible with any water-soluble essential oil. Add 3–5 drops to a full tank. Do not use fragrance oils, carrier oils or anything oil-based without water — these can damage the ultrasonic plate and will void your warranty. Never run the unit dry.</p>" } },
        { "type": "item", "settings": { "heading": "Cleaning and care", "body": "<p>Unplug and empty the tank after each use. Wipe the inside with a soft dry cloth. Once a week, clean the ultrasonic plate with a cotton bud dampened with white vinegar, then wipe dry. Do not submerge the unit in water and do not put any part of it in a dishwasher.</p>" } },
        { "type": "item", "settings": { "heading": "Warranty and returns", "body": "<p>Every Lumisca diffuser is covered by a 12-month warranty against manufacturing defects, plus our 30-day money-back guarantee. Email lumiscastore@outlook.com with your order number and we'll sort it.</p>" } }
      ]
    }
  ]
}
{% endschema %}
