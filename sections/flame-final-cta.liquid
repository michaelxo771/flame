{%- comment -%} Lumisca — Final CTA Banner (hardcoded, real in-home photo bg) {%- endcomment -%}
{%- style -%}
  #shopify-section-{{ section.id }} .flame-cta { position: relative; padding: 5.4rem 0; text-align: center; overflow: hidden; isolation: isolate; color: #F7F3EE; }
  #shopify-section-{{ section.id }} .flame-cta__media { position: absolute; inset: 0; z-index: -2; }
  #shopify-section-{{ section.id }} .flame-cta__media img { width: 100%; height: 100%; object-fit: cover; }
  #shopify-section-{{ section.id }} .flame-cta__overlay { position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, rgba(14,12,11,.55) 0%, rgba(14,12,11,.72) 100%); }
  #shopify-section-{{ section.id }} .flame-cta__title { font-size: 3rem; line-height: 1.12; margin: 0 0 1.6rem; text-wrap: balance; }
  #shopify-section-{{ section.id }} .flame-cta__sub { font-size: 1.65rem; margin: 0 auto 2.2rem; max-width: 44ch; opacity: .95; }
  #shopify-section-{{ section.id }} .flame-cta__btn { min-width: 240px; font-size: 1.75rem; padding: 1.4rem 2.6rem; }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .flame-cta { padding: 7.4rem 0; }
    #shopify-section-{{ section.id }} .flame-cta__title { font-size: 4.4rem; }
  }
{%- endstyle -%}

<div class="flame-cta">
  <div class="flame-cta__media">
    <img src="{{ 'A11e5b99e17ff4bf599a6700207eccd87c.webp' | file_url }}" alt="Mini Flame Aroma Diffuser glowing in a warm, dim room" width="1600" height="900" loading="lazy">
  </div>
  <div class="flame-cta__overlay"></div>
  <div class="page-width">
    <h2 class="flame-cta__title">Bring the Cosy Home Tonight</h2>
    <p class="flame-cta__sub">Limited-time 40% off — free UK &amp; Ireland shipping while it lasts.</p>
    {% render 'flame-buy-button', label: 'Shop Now — 40% Off', class: 'flame-cta__btn' %}
  </div>
</div>

{% schema %}
{ "name": "Flame Final CTA", "tag": "section", "class": "flame-section", "settings": [], "presets": [ { "name": "Flame Final CTA" } ] }
{% endschema %}
