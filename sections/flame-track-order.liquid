{%- comment -%} Lumisca — Track Order (hardcoded) {%- endcomment -%}
{%- style -%}
  #shopify-section-{{ section.id }} .flame-track { padding: 4.4rem 0; }
  #shopify-section-{{ section.id }} .flame-track__inner { max-width: 640px; margin: 0 auto; text-align: center; }
  #shopify-section-{{ section.id }} .flame-track__icon { font-size: 3rem; margin-bottom: 1rem; }
  #shopify-section-{{ section.id }} .flame-track__title { font-size: 2.8rem; margin: 0 0 1.2rem; }
  #shopify-section-{{ section.id }} .flame-track__body { font-size: 1.6rem; line-height: 1.6; opacity: .92; margin: 0 0 2rem; }
  #shopify-section-{{ section.id }} .flame-track__btn { min-width: 220px; }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .flame-track { padding: 6.4rem 0; }
    #shopify-section-{{ section.id }} .flame-track__title { font-size: 3.6rem; }
  }
{%- endstyle -%}

<div class="color-scheme-1 gradient">
  <div class="page-width flame-track">
    <div class="flame-track__inner">
      <div class="flame-track__icon" aria-hidden="true">📦</div>
      <h1 class="flame-track__title">Track Your Order</h1>
      <p class="flame-track__body">Pop your tracking number into the box below to see exactly where your Lumisca is. Didn't get a tracking email yet? Orders ship within 1–2 business days — hang tight, it's on the way. Any trouble at all, email <strong>support@lumisca.co.uk</strong> and we'll help right away.</p>
      <a href="https://t.17track.net/en" class="button flame-track__btn" target="_blank" rel="noopener">Track My Order</a>
    </div>
  </div>
</div>

{% schema %}
{ "name": "Flame Track Order", "tag": "section", "class": "flame-section", "settings": [], "presets": [ { "name": "Flame Track Order" } ] }
{% endschema %}
