{%- comment -%} Lumisca — Comparison Table (hardcoded) {%- endcomment -%}
{%- style -%}
  #shopify-section-{{ section.id }} .flame-cmp { padding: 4.4rem 0; }
  #shopify-section-{{ section.id }} .flame-cmp__title { font-size: 2.8rem; text-align: center; margin: 0 0 2.6rem; }
  #shopify-section-{{ section.id }} .flame-cmp__table { width: 100%; max-width: 720px; margin: 0 auto; border-collapse: collapse; border-radius: 14px; overflow: hidden; box-shadow: 0 10px 30px rgba(14,12,11,.10); }
  #shopify-section-{{ section.id }} .flame-cmp__table th, #shopify-section-{{ section.id }} .flame-cmp__table td { padding: 1.4rem 1rem; text-align: center; border-bottom: 1px solid rgba(138,128,120,.22); font-size: 1.4rem; }
  #shopify-section-{{ section.id }} .flame-cmp__table thead th { font-weight: 700; background: rgba(200,98,46,.10); }
  #shopify-section-{{ section.id }} .flame-cmp__table th:first-child, #shopify-section-{{ section.id }} .flame-cmp__table td:first-child { text-align: left; font-weight: 600; }
  #shopify-section-{{ section.id }} .flame-cmp__brand { background: #C8622E; color: #fff; }
  #shopify-section-{{ section.id }} .flame-cmp__yes { color: #1f8a4c; font-size: 1.9rem; font-weight: 700; }
  #shopify-section-{{ section.id }} .flame-cmp__no { color: #b23b3b; font-size: 1.9rem; font-weight: 700; }
  #shopify-section-{{ section.id }} .flame-cmp__table tr:last-child td { border-bottom: none; }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .flame-cmp { padding: 6.4rem 0; }
    #shopify-section-{{ section.id }} .flame-cmp__title { font-size: 3.6rem; }
    #shopify-section-{{ section.id }} .flame-cmp__table th, #shopify-section-{{ section.id }} .flame-cmp__table td { padding: 1.7rem 1.6rem; font-size: 1.6rem; }
  }
{%- endstyle -%}

<div class="color-scheme-1 gradient">
  <div class="page-width flame-cmp">
    <h2 class="flame-cmp__title">Why Lumisca Wins</h2>
    <table class="flame-cmp__table">
      <thead>
        <tr>
          <th scope="col">Feature</th>
          <th scope="col" class="flame-cmp__brand">Lumisca</th>
          <th scope="col">Ordinary Diffusers</th>
        </tr>
      </thead>
      <tbody>
        <tr><td>Realistic Flame Effect</td><td class="flame-cmp__yes" aria-label="Yes">✓</td><td class="flame-cmp__no" aria-label="No">✗</td></tr>
        <tr><td>Aromatherapy</td><td class="flame-cmp__yes" aria-label="Yes">✓</td><td class="flame-cmp__no" aria-label="No">✗</td></tr>
        <tr><td>Whisper-Quiet</td><td class="flame-cmp__yes" aria-label="Yes">✓</td><td class="flame-cmp__no" aria-label="No">✗</td></tr>
        <tr><td>Auto Shut-Off</td><td class="flame-cmp__yes" aria-label="Yes">✓</td><td class="flame-cmp__no" aria-label="No">✗</td></tr>
        <tr><td>Cosy Ambience</td><td class="flame-cmp__yes" aria-label="Yes">✓</td><td class="flame-cmp__no" aria-label="No">✗</td></tr>
      </tbody>
    </table>
  </div>
</div>

{% schema %}
{ "name": "Flame Comparison", "tag": "section", "class": "flame-section", "settings": [], "presets": [ { "name": "Flame Comparison" } ] }
{% endschema %}
