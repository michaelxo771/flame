{%- comment -%} Lumisca — Comparison (premium, ember-highlighted column) {%- endcomment -%}
{%- style -%}
  #shopify-section-{{ section.id }} .flame-cmp { background: var(--bg-dark); }
  #shopify-section-{{ section.id }} .flame-cmp__head { text-align: center; margin-bottom: 4rem; }
  #shopify-section-{{ section.id }} .flame-cmp__title { font-size: clamp(2.8rem, 4.4vw, 3.8rem); color: var(--text-cream); margin: 0; }
  #shopify-section-{{ section.id }} .flame-cmp__wrap { max-width: 760px; margin: 0 auto; border-radius: 20px; overflow: hidden; border: 1px solid rgba(244,238,230,.1); background: linear-gradient(180deg, rgba(255,255,255,.04), rgba(255,255,255,.01)); box-shadow: var(--shadow-soft); }
  #shopify-section-{{ section.id }} table { width: 100%; border-collapse: collapse; }
  #shopify-section-{{ section.id }} th, #shopify-section-{{ section.id }} td { padding: 1.8rem 1.4rem; text-align: center; font-size: 1.5rem; }
  #shopify-section-{{ section.id }} thead th { font-family: var(--flame-serif); font-size: 1.7rem; color: var(--text-cream); font-weight: 500; padding-block: 2.4rem; }
  #shopify-section-{{ section.id }} th:first-child, #shopify-section-{{ section.id }} td:first-child { text-align: left; color: var(--text-cream); font-weight: 500; }
  #shopify-section-{{ section.id }} tbody tr { border-top: 1px solid rgba(244,238,230,.07); transition: background .3s var(--ease); }
  #shopify-section-{{ section.id }} tbody tr:hover { background: rgba(244,238,230,.03); }
  /* ember-highlighted Lumisca column */
  #shopify-section-{{ section.id }} .flame-cmp__brandcol { position: relative; background: linear-gradient(180deg, rgba(212,104,46,.16), rgba(212,104,46,.05)); box-shadow: inset 0 0 0 1px rgba(212,104,46,.35); }
  #shopify-section-{{ section.id }} thead .flame-cmp__brandcol { color: var(--ember); }
  #shopify-section-{{ section.id }} .flame-cmp__other { color: var(--text-muted); }
  #shopify-section-{{ section.id }} .flame-ic-yes { display: inline-flex; width: 30px; height: 30px; align-items: center; justify-content: center; border-radius: 50%; background: rgba(212,104,46,.15); color: var(--ember); }
  #shopify-section-{{ section.id }} .flame-ic-no { display: inline-flex; width: 30px; height: 30px; align-items: center; justify-content: center; border-radius: 50%; background: rgba(244,238,230,.05); color: #9a8d80; }
  #shopify-section-{{ section.id }} .flame-ic-yes svg, #shopify-section-{{ section.id }} .flame-ic-no svg { width: 18px; height: 18px; }
{%- endstyle -%}

{%- assign features = 'Realistic Flame Effect,Aromatherapy,Whisper-Quiet,Auto Shut-Off,Cosy Ambience' | split: ',' -%}

<div class="flame-cmp flame-section flame-grain">
  <div class="flame-wrap flame-pad">
    <div class="flame-cmp__head flame-reveal">
      <p class="flame-kicker flame-kicker--center">Why Lumisca</p>
      <h2 class="flame-cmp__title">Why Lumisca Wins</h2>
    </div>
    <div class="flame-cmp__wrap flame-reveal" data-delay="1">
      <table>
        <thead>
          <tr>
            <th scope="col">Feature</th>
            <th scope="col" class="flame-cmp__brandcol">Lumisca</th>
            <th scope="col" class="flame-cmp__other">Ordinary Diffusers</th>
          </tr>
        </thead>
        <tbody>
          {%- for feature in features -%}
          <tr>
            <td>{{ feature }}</td>
            <td class="flame-cmp__brandcol">
              <span class="flame-ic-yes" aria-label="Yes"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span>
            </td>
            <td class="flame-cmp__other">
              <span class="flame-ic-no" aria-label="No"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg></span>
            </td>
          </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
  </div>
</div>

{% schema %}
{ "name": "Flame Comparison", "tag": "section", "class": "flame-section", "settings": [], "presets": [ { "name": "Flame Comparison" } ] }
{% endschema %}
