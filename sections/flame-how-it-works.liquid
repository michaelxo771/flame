{%- comment -%} Lumisca — The Ritual (how it works) {%- endcomment -%}
{%- style -%}
  #shopify-section-{{ section.id }} .flame-rt { background: var(--bg-deep); }
  #shopify-section-{{ section.id }} .flame-rt__head { text-align: center; margin-bottom: 5rem; }
  #shopify-section-{{ section.id }} .flame-rt__title { font-size: clamp(2.8rem, 4.4vw, 3.8rem); color: var(--text-cream); margin: 0; }
  #shopify-section-{{ section.id }} .flame-rt__steps { position: relative; display: grid; grid-template-columns: 1fr; gap: 3.4rem; }
  #shopify-section-{{ section.id }} .flame-rt__line { display: none; }
  #shopify-section-{{ section.id }} .flame-rt__step { position: relative; text-align: center; z-index: 1; }
  #shopify-section-{{ section.id }} .flame-rt__badge { width: 6.4rem; height: 6.4rem; margin: 0 auto 1.8rem; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: radial-gradient(circle at 50% 35%, var(--ember-hover), var(--ember-deep)); color: #fff; font-family: var(--flame-serif); font-size: 2.4rem; box-shadow: 0 0 0 6px rgba(212,104,46,.12), 0 10px 30px rgba(212,104,46,.35); }
  #shopify-section-{{ section.id }} .flame-rt__ct { font-size: 2rem; color: var(--text-cream); margin: 0 0 .8rem; }
  #shopify-section-{{ section.id }} .flame-rt__cx { font-size: 1.5rem; line-height: 1.65; color: var(--text-muted); margin: 0 auto; max-width: 30ch; }
  @media screen and (min-width: 850px) {
    #shopify-section-{{ section.id }} .flame-rt__steps { grid-template-columns: repeat(3, 1fr); gap: 2.4rem; }
    #shopify-section-{{ section.id }} .flame-rt__line { display: block; position: absolute; top: 3.2rem; left: 16%; right: 16%; height: 1px; background: linear-gradient(90deg, transparent, var(--gold), transparent); transform: scaleX(0); transform-origin: left; transition: transform 1.1s var(--ease) .2s; z-index: 0; }
    #shopify-section-{{ section.id }} .flame-rt__steps.is-visible .flame-rt__line { transform: scaleX(1); }
  }
{%- endstyle -%}

<div class="flame-rt flame-section flame-grain">
  <div class="flame-wrap flame-pad">
    <div class="flame-rt__head flame-reveal">
      <p class="flame-kicker flame-kicker--center">The Ritual</p>
      <h2 class="flame-rt__title">Three Steps to Calm</h2>
    </div>
    <div class="flame-rt__steps flame-reveal">
      <div class="flame-rt__line" aria-hidden="true"></div>
      <div class="flame-rt__step">
        <div class="flame-rt__badge">I</div>
        <h3 class="flame-rt__ct">Fill</h3>
        <p class="flame-rt__cx">Add water and a few drops of your favourite essential oil.</p>
      </div>
      <div class="flame-rt__step">
        <div class="flame-rt__badge">II</div>
        <h3 class="flame-rt__ct">Choose Your Glow</h3>
        <p class="flame-rt__cx">Tap through 7 warm flame colours — or settle on your favourite.</p>
      </div>
      <div class="flame-rt__step">
        <div class="flame-rt__badge">III</div>
        <h3 class="flame-rt__ct">Unwind</h3>
        <p class="flame-rt__cx">Let gentle mist and cosy light fill the room. Auto shut-off keeps it safe.</p>
      </div>
    </div>
  </div>
</div>

{% schema %}
{ "name": "Flame How It Works", "tag": "section", "class": "flame-section", "settings": [], "presets": [ { "name": "Flame How It Works" } ] }
{% endschema %}
