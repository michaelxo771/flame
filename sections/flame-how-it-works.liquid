{%- comment -%} Lumisca — How It Works (hardcoded) {%- endcomment -%}
{%- style -%}
  #shopify-section-{{ section.id }} .flame-how { padding: 4.4rem 0; text-align: center; }
  #shopify-section-{{ section.id }} .flame-how__title { font-size: 2.8rem; margin: 0 0 3rem; }
  #shopify-section-{{ section.id }} .flame-how__grid { display: grid; grid-template-columns: 1fr; gap: 2.6rem; }
  #shopify-section-{{ section.id }} .flame-how__num { width: 5.4rem; height: 5.4rem; margin: 0 auto 1.2rem; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #C8622E; color: #fff; font-size: 2.2rem; font-weight: 700; }
  #shopify-section-{{ section.id }} .flame-how__step-title { font-size: 2rem; margin: 0 0 .6rem; }
  #shopify-section-{{ section.id }} .flame-how__step-text { font-size: 1.5rem; line-height: 1.5; opacity: .9; margin: 0 auto; max-width: 34ch; }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .flame-how { padding: 6.4rem 0; }
    #shopify-section-{{ section.id }} .flame-how__title { font-size: 3.6rem; }
    #shopify-section-{{ section.id }} .flame-how__grid { grid-template-columns: repeat(3, 1fr); gap: 3.2rem; }
  }
{%- endstyle -%}

<div class="color-scheme-2 gradient">
  <div class="page-width flame-how">
    <h2 class="flame-how__title">How It Works</h2>
    <div class="flame-how__grid">
      <div class="flame-how__step">
        <div class="flame-how__num" aria-hidden="true">1</div>
        <h3 class="flame-how__step-title">Fill</h3>
        <p class="flame-how__step-text">Add water and a few drops of your favourite essential oil.</p>
      </div>
      <div class="flame-how__step">
        <div class="flame-how__num" aria-hidden="true">2</div>
        <h3 class="flame-how__step-title">Choose Your Glow</h3>
        <p class="flame-how__step-text">Tap to cycle through 7 warm flame colours — or lock in your favourite.</p>
      </div>
      <div class="flame-how__step">
        <div class="flame-how__num" aria-hidden="true">3</div>
        <h3 class="flame-how__step-title">Relax</h3>
        <p class="flame-how__step-text">Sit back as gentle mist and cosy light fill the room. Auto shut-off keeps it safe.</p>
      </div>
    </div>
  </div>
</div>

{% schema %}
{ "name": "Flame How It Works", "tag": "section", "class": "flame-section", "settings": [], "presets": [ { "name": "Flame How It Works" } ] }
{% endschema %}
