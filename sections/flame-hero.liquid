{%- comment -%}
  Lumisca — Flame Hero. Fully hardcoded. Uses the real product image + auto-resolved product link.
{%- endcomment -%}
{%- liquid
  assign fp = collections.all.products.first
  for p in collections.all.products
    if p.title contains 'Diffuser' or p.title contains 'Flame' or p.title contains 'Lumisca'
      assign fp = p
      break
    endif
  endfor
-%}
{%- style -%}
  #shopify-section-{{ section.id }} .flame-hero {
    position: relative; overflow: hidden; isolation: isolate;
    background: radial-gradient(120% 120% at 50% 0%, #241a15 0%, #0E0C0B 60%);
  }
  #shopify-section-{{ section.id }} .flame-hero__grid {
    display: flex; flex-direction: column; align-items: center; text-align: center;
    gap: 2.4rem; padding: 3.6rem 0 4.4rem;
  }
  #shopify-section-{{ section.id }} .flame-hero__media {
    width: 100%; max-width: 320px;
  }
  #shopify-section-{{ section.id }} .flame-hero__media img {
    width: 100%; height: auto; display: block;
    border-radius: 18px;
    box-shadow: 0 24px 60px rgba(200,98,46,.28), 0 8px 24px rgba(0,0,0,.4);
  }
  #shopify-section-{{ section.id }} .flame-hero__content { max-width: 620px; color: #F7F3EE; }
  #shopify-section-{{ section.id }} .flame-hero__eyebrow {
    letter-spacing: .32em; text-transform: uppercase; font-size: 1.2rem; opacity: .8; margin: 0 0 1.4rem;
  }
  #shopify-section-{{ section.id }} .flame-hero__title { font-size: 3.2rem; line-height: 1.08; margin: 0 0 1.4rem; text-wrap: balance; }
  #shopify-section-{{ section.id }} .flame-hero__subtitle { font-size: 1.65rem; line-height: 1.5; margin: 0 auto 2.2rem; max-width: 46ch; opacity: .92; }
  #shopify-section-{{ section.id }} .flame-hero__cta { min-width: 260px; font-size: 1.7rem; padding: 1.4rem 2.6rem; }
  #shopify-section-{{ section.id }} .flame-hero__trust { margin: 1.8rem 0 0; font-size: 1.35rem; opacity: .92; }
  #shopify-section-{{ section.id }} .flame-hero__stars { color: #F5B841; letter-spacing: .1em; }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .flame-hero__grid {
      flex-direction: row-reverse; text-align: left; gap: 4rem; padding: 6rem 0;
      align-items: center; justify-content: space-between;
    }
    #shopify-section-{{ section.id }} .flame-hero__media { max-width: 420px; flex: 0 0 auto; }
    #shopify-section-{{ section.id }} .flame-hero__subtitle { margin-left: 0; }
    #shopify-section-{{ section.id }} .flame-hero__title { font-size: 5.2rem; }
    #shopify-section-{{ section.id }} .flame-hero__subtitle { font-size: 1.9rem; }
  }
{%- endstyle -%}

<div class="flame-hero">
  <div class="page-width flame-hero__grid">
    <div class="flame-hero__media">
      {%- if fp.featured_image != blank -%}
        {{ fp.featured_image | image_url: width: 840 | image_tag:
            loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 750px) 420px, 320px',
            widths: '320, 420, 640, 840', alt: fp.featured_image.alt | default: 'Mini Flame Aroma Diffuser' | escape }}
      {%- else -%}
        <img src="{{ 'Air-Aroma-Humidifier-Diffuser-Essential-Oils-Humidifiers-Mini-Flame-Automatic-Fragrance-Diffuser-Home-Humidifier-With-LED.webp' | file_url }}" alt="Mini Flame Aroma Diffuser" width="420" height="420" loading="eager" fetchpriority="high">
      {%- endif -%}
    </div>
    <div class="flame-hero__content">
      <p class="flame-hero__eyebrow">Lumisca</p>
      <h1 class="flame-hero__title">Turn Any Room Into a Cosy, Fire-Lit Escape</h1>
      <p class="flame-hero__subtitle">The calming glow of a real flame — with none of the smoke, soot or danger. Just soothing light, gentle mist, and your favourite scents.</p>
      {% render 'flame-buy-button', label: 'Shop Now — 40% Off', class: 'flame-hero__cta' %}
      <p class="flame-hero__trust"><span class="flame-hero__stars">★★★★★</span> Loved by 900+ happy customers · Free UK/IE shipping</p>
    </div>
  </div>
</div>

{% schema %}
{ "name": "Flame Hero", "tag": "section", "class": "flame-section", "settings": [], "presets": [ { "name": "Flame Hero" } ] }
{% endschema %}
