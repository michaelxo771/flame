{%- comment -%} Lumisca — Problem → Solution (emotional hook) {%- endcomment -%}
{%- style -%}
  #shopify-section-{{ section.id }} .flame-ps {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    padding: 4.4rem 0;
    align-items: center;
  }
  #shopify-section-{{ section.id }} .flame-ps__media img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 14px;
  }
  #shopify-section-{{ section.id }} .flame-ps__title {
    font-size: 2.8rem;
    line-height: 1.15;
    margin: 0 0 1.4rem;
    text-wrap: balance;
  }
  #shopify-section-{{ section.id }} .flame-ps__body { font-size: 1.65rem; line-height: 1.6; opacity: .92; }
  #shopify-section-{{ section.id }} .flame-ps__body p { margin: 0 0 1.2rem; }
  #shopify-section-{{ section.id }} .flame-ps__cta { margin-top: 2rem; }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .flame-ps {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      padding: 7rem 0;
    }
    {% if section.settings.image_position == 'right' %}
    #shopify-section-{{ section.id }} .flame-ps__media { order: 2; }
    {% endif %}
    #shopify-section-{{ section.id }} .flame-ps__title { font-size: 3.6rem; }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width flame-ps">
    <div class="flame-ps__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 900 | image_tag:
            loading: 'lazy', sizes: '(min-width: 750px) 50vw, 100vw',
            widths: '375, 550, 750, 900, 1100',
            alt: section.settings.image.alt | default: section.settings.title | escape }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'flame-ps__placeholder' }}
      {%- endif -%}
    </div>
    <div class="flame-ps__text">
      {%- if section.settings.title != blank -%}
        <h2 class="flame-ps__title">{{ section.settings.title | escape }}</h2>
      {%- endif -%}
      <div class="flame-ps__body rte">{{ section.settings.body }}</div>
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: '#' }}" class="button flame-ps__cta">{{ section.settings.button_label | escape }}</a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Flame Problem/Solution",
  "tag": "section",
  "class": "flame-section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "select", "id": "image_position", "label": "Image position (desktop)", "options": [
      { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ], "default": "right" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Your Home Should Feel Like an Escape" },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>After a long, stressful day, you deserve to walk into calm. Harsh lighting and stale air keep your nervous system on edge.</p><p>Lumisca transforms any space in seconds — a dancing flame glow and soothing aroma that melt the stress away.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop Now" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "presets": [ { "name": "Flame Problem/Solution" } ]
}
{% endschema %}
