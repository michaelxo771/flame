{%- comment -%} Lumisca — Problem → Solution (hardcoded, real in-home photo) {%- endcomment -%}
{%- style -%}
  #shopify-section-{{ section.id }} .flame-ps { display: grid; grid-template-columns: 1fr; gap: 2rem; padding: 4.4rem 0; align-items: center; }
  #shopify-section-{{ section.id }} .flame-ps__media img { width: 100%; height: auto; display: block; border-radius: 14px; }
  #shopify-section-{{ section.id }} .flame-ps__title { font-size: 2.8rem; line-height: 1.15; margin: 0 0 1.4rem; text-wrap: balance; }
  #shopify-section-{{ section.id }} .flame-ps__body { font-size: 1.65rem; line-height: 1.6; opacity: .92; }
  #shopify-section-{{ section.id }} .flame-ps__body p { margin: 0 0 1.2rem; }
  #shopify-section-{{ section.id }} .flame-ps__cta { margin-top: 1rem; }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .flame-ps { grid-template-columns: 1fr 1fr; gap: 4rem; padding: 7rem 0; }
    #shopify-section-{{ section.id }} .flame-ps__media { order: 2; }
    #shopify-section-{{ section.id }} .flame-ps__title { font-size: 3.6rem; }
  }
{%- endstyle -%}

<div class="color-scheme-1 gradient">
  <div class="page-width flame-ps">
    <div class="flame-ps__media">
      <img src="{{ 'A330e6b8753c74c97b57d60c5f3de4aa6h.webp' | file_url }}"
           alt="Mini Flame Aroma Diffuser glowing in a cosy living room"
           width="800" height="800" loading="lazy" sizes="(min-width: 750px) 50vw, 100vw">
    </div>
    <div class="flame-ps__text">
      <h2 class="flame-ps__title">Your Home Should Feel Like an Escape</h2>
      <div class="flame-ps__body">
        <p>After a long, stressful day, you deserve to walk into calm. Harsh lighting and stale air keep your nervous system on edge.</p>
        <p>Lumisca transforms any space in seconds — a dancing flame glow and soothing aroma that melt the stress away.</p>
      </div>
      {% render 'flame-buy-button', label: 'Shop Now', class: 'flame-ps__cta' %}
    </div>
  </div>
</div>

{% schema %}
{ "name": "Flame Problem/Solution", "tag": "section", "class": "flame-section", "settings": [], "presets": [ { "name": "Flame Problem/Solution" } ] }
{% endschema %}
