{%- comment -%} Lumisca — Trust Bar (hardcoded) {%- endcomment -%}
{%- style -%}
  #shopify-section-{{ section.id }} .flame-trustbar {
    display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.2rem .8rem; padding: 2rem 1.5rem;
  }
  #shopify-section-{{ section.id }} .flame-trustbar__item { display: flex; flex-direction: column; align-items: center; text-align: center; gap: .5rem; }
  #shopify-section-{{ section.id }} .flame-trustbar__icon { font-size: 2.4rem; line-height: 1; }
  #shopify-section-{{ section.id }} .flame-trustbar__label { font-size: 1.25rem; line-height: 1.3; font-weight: 600; }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .flame-trustbar { grid-template-columns: repeat(4, 1fr); padding: 2.4rem 1.5rem; gap: 1rem; }
    #shopify-section-{{ section.id }} .flame-trustbar__item { flex-direction: row; gap: .9rem; }
    #shopify-section-{{ section.id }} .flame-trustbar__label { font-size: 1.4rem; text-align: left; }
  }
{%- endstyle -%}

<div class="color-scheme-2 gradient">
  <div class="page-width flame-trustbar">
    <div class="flame-trustbar__item"><span class="flame-trustbar__icon" aria-hidden="true">🚚</span><span class="flame-trustbar__label">Free UK/IE Shipping</span></div>
    <div class="flame-trustbar__item"><span class="flame-trustbar__icon" aria-hidden="true">🔥</span><span class="flame-trustbar__label">No Real Flame — 100% Safe</span></div>
    <div class="flame-trustbar__item"><span class="flame-trustbar__icon" aria-hidden="true">⏱</span><span class="flame-trustbar__label">5-Hour Runtime</span></div>
    <div class="flame-trustbar__item"><span class="flame-trustbar__icon" aria-hidden="true">↩️</span><span class="flame-trustbar__label">30-Day Guarantee</span></div>
  </div>
</div>

{% schema %}
{ "name": "Flame Trust Bar", "tag": "section", "class": "flame-section", "settings": [], "presets": [ { "name": "Flame Trust Bar" } ] }
{% endschema %}
