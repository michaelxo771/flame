{%- comment -%}
  Lumisca — premium header. Dark glass, solidifies on scroll, animated ember
  underline nav, ember cart badge, slide-in mobile drawer. Hardcoded nav.
{%- endcomment -%}
{%- liquid
  assign fp = collections.all.products.first
  for p in collections.all.products
    if p.title contains 'Diffuser' or p.title contains 'Flame' or p.title contains 'Lumisca'
      assign fp = p
      break
    endif
  endfor
  assign shop_url = fp.url | default: '/collections/all'
-%}
{%- style -%}
  #shopify-section-{{ section.id }} { position: sticky; top: 0; z-index: 55; }
  .flame-hd { transition: background .4s var(--ease), box-shadow .4s var(--ease), backdrop-filter .4s var(--ease); background: linear-gradient(180deg, rgba(11,9,8,.9), rgba(11,9,8,.55)); }
  .flame-hd.is-scrolled { background: rgba(11,9,8,.92); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); box-shadow: 0 10px 40px rgba(0,0,0,.45); }
  .flame-hd__bar { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; min-height: 72px; }
  .flame-hd__logo { font-family: var(--flame-serif); font-size: 2.6rem; font-weight: 500; letter-spacing: .3em; text-transform: uppercase; color: var(--text-cream); text-decoration: none; line-height: 1; padding-left: .3em; }
  .flame-hd__nav { display: none; }
  .flame-hd__nav a { position: relative; color: var(--text-cream); text-decoration: none; font-size: 1.4rem; font-weight: 500; letter-spacing: .12em; text-transform: uppercase; padding: .4rem 0; }
  .flame-hd__nav a::after { content: ''; position: absolute; left: 0; right: 0; bottom: -4px; height: 1.5px; background: var(--ember); transform: scaleX(0); transform-origin: left; transition: transform .35s var(--ease); }
  .flame-hd__nav a:hover { color: var(--text-cream); }
  .flame-hd__nav a:hover::after { transform: scaleX(1); }
  .flame-hd__right { display: flex; align-items: center; gap: 1.6rem; }
  .flame-hd__cart { position: relative; display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; margin-right: -10px; color: var(--text-cream); }
  .flame-hd__cart svg { width: 24px; height: 24px; }
  .flame-hd__count { position: absolute; top: -7px; right: -9px; min-width: 18px; height: 18px; padding: 0 5px; border-radius: 999px; background: var(--ember); color: #fff; font-size: 1.05rem; line-height: 18px; text-align: center; font-weight: 700; box-shadow: 0 0 0 2px rgba(11,9,8,.9); }
  /* burger */
  .flame-hd__burger { display: inline-flex; flex-direction: column; justify-content: center; align-items: center; gap: 5px; width: 44px; height: 44px; margin-left: -10px; background: none; border: 0; cursor: pointer; padding: 0; }
  .flame-hd__burger span { display: block; height: 1.5px; width: 24px; background: var(--text-cream); border-radius: 2px; transition: transform .3s var(--ease), opacity .3s var(--ease); }
  .flame-hd__burger.is-open span:nth-child(1) { transform: translateY(6.5px) rotate(45deg); }
  .flame-hd__burger.is-open span:nth-child(2) { opacity: 0; }
  .flame-hd__burger.is-open span:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); }
  /* drawer */
  .flame-drawer { position: fixed; inset: 0; z-index: 200; background: rgba(11,9,8,.55); opacity: 0; visibility: hidden; transition: opacity .4s var(--ease), visibility .4s; }
  .flame-drawer.is-open { opacity: 1; visibility: visible; }
  .flame-drawer__panel { position: absolute; top: 0; right: 0; height: 100%; width: min(82vw, 360px); background: var(--bg-dark); border-left: 1px solid rgba(201,162,75,.25); padding: 3rem 2.6rem calc(3rem + env(safe-area-inset-bottom)); display: flex; flex-direction: column; gap: .4rem; overflow-y: auto; -webkit-overflow-scrolling: touch; transform: translateX(100%); transition: transform .45s var(--ease); }
  .flame-drawer.is-open .flame-drawer__panel { transform: none; }
  .flame-drawer__close { align-self: flex-end; display: flex; align-items: center; justify-content: center; width: 44px; height: 44px; margin: -.6rem -1rem 1rem 0; background: none; border: 0; color: var(--text-cream); font-size: 2.6rem; line-height: 1; cursor: pointer; }
  .flame-drawer__panel a { color: var(--text-cream); text-decoration: none; font-family: var(--flame-serif); font-size: 2.2rem; padding: 1.4rem 0; border-bottom: 1px solid rgba(244,238,230,.08); }
  .flame-drawer__panel a:hover { color: var(--ember); }
  .flame-drawer__cta { margin-top: 2.4rem; }
  @media screen and (min-width: 990px) {
    .flame-hd__burger { display: none; }
    .flame-hd__nav { display: flex; align-items: center; gap: 3.4rem; }
    .flame-hd__bar { min-height: 84px; }
  }
{%- endstyle -%}

<div class="flame-hd flame-section" data-flame-header>
  <div class="flame-wrap flame-hd__bar">
    <button class="flame-hd__burger" data-flame-burger aria-label="Open menu" aria-expanded="false"><span></span><span></span><span></span></button>

    <a href="{{ routes.root_url }}" class="flame-hd__logo">Lumisca</a>

    <nav class="flame-hd__nav" aria-label="Primary">
      <a href="{{ routes.root_url }}">Home</a>
      <a href="{{ shop_url }}">Shop</a>
      <a href="{{ routes.root_url }}#reviews">Reviews</a>
      <a href="/pages/track-order">Track Order</a>
      <a href="/pages/contact">Contact</a>
    </nav>

    <div class="flame-hd__right">
      <a href="{{ routes.cart_url }}" class="flame-hd__cart" id="cart-icon-bubble" aria-label="Cart ({{ cart.item_count }} items)">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M6 7h12l-1 13H7L6 7z" stroke-linejoin="round"/><path d="M9 7a3 3 0 0 1 6 0" stroke-linecap="round"/></svg>
        {%- if cart.item_count > 0 -%}<span class="flame-hd__count">{{ cart.item_count }}</span>{%- endif -%}
      </a>
    </div>
  </div>
</div>

<div class="flame-drawer" data-flame-drawer>
  <div class="flame-drawer__panel">
    <button class="flame-drawer__close" data-flame-drawer-close aria-label="Close menu">&times;</button>
    <a href="{{ routes.root_url }}">Home</a>
    <a href="{{ shop_url }}">Shop</a>
    <a href="{{ routes.root_url }}#reviews">Reviews</a>
    <a href="/pages/track-order">Track Order</a>
    <a href="/pages/contact">Contact</a>
    {% render 'flame-buy-button', label: 'Shop Now', class: 'flame-drawer__cta' %}
  </div>
</div>

{% schema %}
{ "name": "Flame Header", "settings": [], "enabled_on": { "groups": ["header"] } }
{% endschema %}
