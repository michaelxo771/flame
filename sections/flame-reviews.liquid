{%- comment -%}
  Lumisca — Reviews (masonry). Renders the shared snippets/review-card.liquid
  so the homepage and product page reviews stay identical.
{%- endcomment -%}
{%- style -%}
  #shopify-section-{{ section.id }} .flame-rv { background: var(--bg-deep); }
  #shopify-section-{{ section.id }} .flame-rv__head { text-align: center; margin-bottom: 3.4rem; }
  #shopify-section-{{ section.id }} .flame-rv__title { font-size: clamp(2.8rem, 4.4vw, 3.8rem); color: var(--text-cream); margin: 0 0 2rem; }
  #shopify-section-{{ section.id }} .flame-rv__stat { display: inline-flex; flex-direction: column; align-items: center; gap: .4rem; }
  #shopify-section-{{ section.id }} .flame-rv__stat b { font-family: var(--flame-serif); font-size: 4.4rem; color: var(--text-cream); line-height: 1; font-weight: 500; }
  #shopify-section-{{ section.id }} .flame-rv__stat .s { color: var(--gold); font-size: 1.8rem; letter-spacing: .12em; }
  #shopify-section-{{ section.id }} .flame-rv__stat small { color: var(--text-muted); font-size: 1.3rem; letter-spacing: .12em; text-transform: uppercase; }
{%- endstyle -%}

{%- assign r_names = 'Emma T.|Ciara M.|Jack R.|Aoife D.|Laura B.|Sean K.|Niamh O.|Tom H.|Grace M.|Conor D.|Hannah P.|Liam F.|Saoirse B.|Oliver W.|Megan R.|Cathal N.' | split: '|' -%}
{%- assign r_texts = "Absolutely obsessed. The flame looks so real and my living room feels instantly cosy.|Ordered two more as gifts. The lavender and glow combo is pure calm.|Whisper quiet and looks premium. I leave it on while I read and drift right off.|Lovely ambience and the mist is gentle. Delivery to Ireland was quick.|The kids call it our little campfire. Totally safe leaving it on in the evenings.|Surprised by the quality for the price. The colours are gorgeous at night.|My little self-care ritual now — pick the amber glow and the room softens.|Does exactly what it promises. Cosy, quiet, and the auto shut-off is reassuring.|Looks so much more expensive than it was. It's the centrepiece of our lounge now.|Bought one for the bedroom and now I have it on every night. So calming.|Gorgeous glow and dead easy to fill. Took a little while to arrive but worth it.|Didn't expect the flame to look this realistic. Everyone who visits asks about it.|The cosiest my flat has ever felt. A few drops of eucalyptus and I'm sorted.|Perfect on the desk while I work from home. Quiet, warm light, lovely scent.|Got it for my mum and she's obsessed. Ordered a second for myself the same week.|Sets the mood for movie nights instantly. Feels like a proper little fireplace." | split: '|' -%}
{%- assign r_photos = 'Aee4d9791e187485ab8bb0994fbfe1b0e1.webp|Ae03b2df0fba24a109d16c3f7caedbbe1H.webp|Ad90f08724cfb432789d6ef15ef7f71eej.webp|A26bd5cd63b5d4d0da26f688849ca3e2ft.webp|Acafc1bd913c04fe68150d13bca5bd8d52.webp|A17ccc66711964f038d56ac4768afe4faH.webp|A22f881bbc6b54d7cb4536819a888ea54A.webp|A92c93f11f8d6435b978b85aee2704ef0n.webp|A967f2667d0da4bd292e9dea360fb9c95e.webp|A024568a461f94894a51c212b89e3919fv.webp|Ae1fb5df3fedb4f40b02fccb404d34a39C.webp|Aa56d8abe092846ceb6b36d90eb97a8baz.webp|Af80dfdf657704b608eab1ec48c43ae8bx.webp|A9ee2e060f8b244e88eddd21da851831fQ.webp|A6d3e3b7a7eb04208b6595d3e75d71447s.webp|A11e5b99e17ff4bf599a6700207eccd87c.webp' | split: '|' -%}
{%- assign r_ratings = '5|5|5|4|5|5|5|5|5|5|4|5|5|5|5|5' | split: '|' -%}

<div class="flame-rv flame-section flame-grain" id="reviews">
  <div class="flame-wrap flame-pad">
    <div class="flame-rv__head flame-reveal">
      <p class="flame-kicker flame-kicker--center">Real Homes</p>
      <h2 class="flame-rv__title">Loved in Homes Across the UK &amp; Ireland</h2>
      <span class="flame-rv__stat"><span class="s">★★★★★</span><b>4.8 / 5</b><small>from 910+ reviews</small></span>
    </div>
    <div class="review-masonry flame-reveal" data-delay="1">
      {%- for name in r_names -%}
        {%- assign i = forloop.index0 -%}
        {% render 'review-card', name: name, text: r_texts[i], photo: r_photos[i], rating: r_ratings[i], verified: true %}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{ "name": "Flame Reviews", "tag": "section", "class": "flame-section", "settings": [], "presets": [ { "name": "Flame Reviews" } ] }
{% endschema %}
