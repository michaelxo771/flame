{%- comment -%} Lumisca — Reviews (hardcoded, real customer photos + UK/IE names) {%- endcomment -%}
{%- style -%}
  #shopify-section-{{ section.id }} .flame-rev { padding: 4.4rem 0; }
  #shopify-section-{{ section.id }} .flame-rev__head { text-align: center; margin-bottom: 2.8rem; }
  #shopify-section-{{ section.id }} .flame-rev__title { font-size: 2.8rem; margin: 0 0 1.2rem; }
  #shopify-section-{{ section.id }} .flame-rev__badge { display: inline-flex; align-items: center; gap: .8rem; padding: .8rem 1.6rem; border-radius: 999px; background: rgba(200,98,46,.10); border: 1px solid rgba(200,98,46,.28); font-size: 1.45rem; font-weight: 600; }
  #shopify-section-{{ section.id }} .flame-rev__badge .stars { color: #F5B841; letter-spacing: .08em; }
  #shopify-section-{{ section.id }} .flame-rev__grid { display: grid; grid-template-columns: 1fr; gap: 1.8rem; }
  #shopify-section-{{ section.id }} .flame-rev__card { background: rgba(247,243,238,.6); border: 1px solid rgba(138,128,120,.20); border-radius: 14px; padding: 2rem; display: flex; flex-direction: column; gap: 1rem; }
  #shopify-section-{{ section.id }} .flame-rev__card img { width: 100%; height: auto; aspect-ratio: 1 / 1; object-fit: cover; border-radius: 10px; display: block; margin-bottom: .4rem; }
  #shopify-section-{{ section.id }} .flame-rev__stars { color: #F5B841; font-size: 1.6rem; letter-spacing: .08em; }
  #shopify-section-{{ section.id }} .flame-rev__text { font-size: 1.5rem; line-height: 1.55; margin: 0; }
  #shopify-section-{{ section.id }} .flame-rev__name { font-size: 1.4rem; font-weight: 700; margin: 0; }
  #shopify-section-{{ section.id }} .flame-rev__verified { font-size: 1.2rem; opacity: .7; font-weight: 500; }
  @media screen and (min-width: 600px) { #shopify-section-{{ section.id }} .flame-rev__grid { grid-template-columns: repeat(2, 1fr); gap: 2rem; } }
  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .flame-rev { padding: 6.4rem 0; }
    #shopify-section-{{ section.id }} .flame-rev__title { font-size: 3.6rem; }
    #shopify-section-{{ section.id }} .flame-rev__grid { grid-template-columns: repeat(4, 1fr); gap: 2.4rem; }
  }
{%- endstyle -%}

{%- assign five = '★★★★★' -%}
{%- assign four = '★★★★☆' -%}
<div class="color-scheme-1 gradient">
  <div class="page-width flame-rev">
    <div class="flame-rev__head">
      <h2 class="flame-rev__title">Loved in Homes Across the UK &amp; Ireland</h2>
      <span class="flame-rev__badge"><span class="stars">★★★★★</span> 4.8 / 5 from 910+ reviews</span>
    </div>
    <div class="flame-rev__grid">
      <article class="flame-rev__card">
        <img src="{{ 'Aee4d9791e187485ab8bb0994fbfe1b0e1.webp' | file_url }}" alt="Lumisca diffuser in a customer's home" width="600" height="600" loading="lazy">
        <div class="flame-rev__stars" aria-label="5 out of 5 stars">{{ five }}</div>
        <p class="flame-rev__text">Absolutely obsessed. The flame looks so real and my living room feels instantly cosy every evening.</p>
        <p class="flame-rev__name">Emma T. <span class="flame-rev__verified">✓ Verified Buyer</span></p>
      </article>
      <article class="flame-rev__card">
        <img src="{{ 'Ae03b2df0fba24a109d16c3f7caedbbe1H.webp' | file_url }}" alt="Lumisca diffuser glowing on a bedside table" width="600" height="600" loading="lazy">
        <div class="flame-rev__stars" aria-label="5 out of 5 stars">{{ five }}</div>
        <p class="flame-rev__text">Bought one for the bedroom and ended up ordering two more as gifts. The lavender + glow combo is pure calm.</p>
        <p class="flame-rev__name">Ciara M. <span class="flame-rev__verified">✓ Verified Buyer</span></p>
      </article>
      <article class="flame-rev__card">
        <img src="{{ 'Ad90f08724cfb432789d6ef15ef7f71eej.webp' | file_url }}" alt="Lumisca diffuser with warm flame effect" width="600" height="600" loading="lazy">
        <div class="flame-rev__stars" aria-label="5 out of 5 stars">{{ five }}</div>
        <p class="flame-rev__text">Whisper quiet and looks premium. I leave it on while I read and drift right off.</p>
        <p class="flame-rev__name">Jack R. <span class="flame-rev__verified">✓ Verified Buyer</span></p>
      </article>
      <article class="flame-rev__card">
        <img src="{{ 'A26bd5cd63b5d4d0da26f688849ca3e2ft.webp' | file_url }}" alt="Lumisca diffuser misting in a living room" width="600" height="600" loading="lazy">
        <div class="flame-rev__stars" aria-label="4 out of 5 stars">{{ four }}</div>
        <p class="flame-rev__text">Lovely ambience and the mist is gentle. Delivery to Ireland was quicker than expected.</p>
        <p class="flame-rev__name">Aoife D. <span class="flame-rev__verified">✓ Verified Buyer</span></p>
      </article>
      <article class="flame-rev__card">
        <img src="{{ 'Acafc1bd913c04fe68150d13bca5bd8d52.webp' | file_url }}" alt="Lumisca diffuser with a red flame glow" width="600" height="600" loading="lazy">
        <div class="flame-rev__stars" aria-label="5 out of 5 stars">{{ five }}</div>
        <p class="flame-rev__text">The kids call it our little campfire. Totally safe, no worries leaving it on in the evenings.</p>
        <p class="flame-rev__name">Laura B. <span class="flame-rev__verified">✓ Verified Buyer</span></p>
      </article>
      <article class="flame-rev__card">
        <img src="{{ 'A17ccc66711964f038d56ac4768afe4faH.webp' | file_url }}" alt="Lumisca diffuser on a shelf at night" width="600" height="600" loading="lazy">
        <div class="flame-rev__stars" aria-label="5 out of 5 stars">{{ five }}</div>
        <p class="flame-rev__text">Genuinely surprised by the quality for the price. The 7 colours are gorgeous on the darker settings.</p>
        <p class="flame-rev__name">Sean K. <span class="flame-rev__verified">✓ Verified Buyer</span></p>
      </article>
      <article class="flame-rev__card">
        <img src="{{ 'A22f881bbc6b54d7cb4536819a888ea54A.webp' | file_url }}" alt="Lumisca diffuser creating cosy light" width="600" height="600" loading="lazy">
        <div class="flame-rev__stars" aria-label="5 out of 5 stars">{{ five }}</div>
        <p class="flame-rev__text">My little self-care ritual now. Fill it, pick the amber glow, and the whole room softens.</p>
        <p class="flame-rev__name">Niamh O. <span class="flame-rev__verified">✓ Verified Buyer</span></p>
      </article>
      <article class="flame-rev__card">
        <img src="{{ 'A92c93f11f8d6435b978b85aee2704ef0n.webp' | file_url }}" alt="Lumisca diffuser with mist and flame" width="600" height="600" loading="lazy">
        <div class="flame-rev__stars" aria-label="5 out of 5 stars">{{ five }}</div>
        <p class="flame-rev__text">Does exactly what it promises. Cosy, quiet, and the auto shut-off gives real peace of mind.</p>
        <p class="flame-rev__name">Tom H. <span class="flame-rev__verified">✓ Verified Buyer</span></p>
      </article>
    </div>
  </div>
</div>

